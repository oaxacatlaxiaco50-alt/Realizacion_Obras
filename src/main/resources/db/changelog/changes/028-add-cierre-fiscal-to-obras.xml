<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="20261113-028-add-cierre-fiscal-to-obras" author="sistema">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="obras" columnName="archivada_fiscal"/>
            </not>
        </preConditions>
        <addColumn tableName="obras">
            <column name="ejercicio_fiscal" type="INTEGER" defaultValueNumeric="2026"/>
            <column name="archivada_fiscal" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="nota_cierre_fiscal" type="TEXT"/>
        </addColumn>
        <sql>
            UPDATE obras SET ejercicio_fiscal = COALESCE(EXTRACT(YEAR FROM fecha_inicio), 2026), archivada_fiscal = false WHERE ejercicio_fiscal IS NULL;
        </sql>
    </changeSet>

</databaseChangeLog>
