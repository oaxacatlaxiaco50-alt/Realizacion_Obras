    <changeSet id="20260630-008-seed-test-users" author="antigravity">
        <!-- Seed Supervisor User -->
        <insert tableName="users">
            <column name="first_name" value="Pedro"/>
            <column name="last_name" value="Supervisor"/>
            <column name="email" value="pedro@obraspublicas.com"/>
            <column name="username" value="supervisor"/>
            <column name="password" value="$2a$10$8.225d3S1reN1g.1t5E.K.w1G2f8/t7LdQpYg7gV5bVjHjK.D5r2u"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="user_roles">
            <column name="user_id" valueComputed="(SELECT id FROM users WHERE username = 'supervisor')"/>
            <column name="role_id" valueComputed="(SELECT id FROM roles WHERE name = 'SUPERVISOR')"/>
        </insert>

