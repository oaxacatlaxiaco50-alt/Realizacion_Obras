<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="20260803-019-create-obra-avances" author="jorge">
        <createTable tableName="obra_avances">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="obra_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_obra_avances_obra_id" references="obras(id)"/>
            </column>
            <column name="titulo" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_avance" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="porcentaje" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="observaciones" type="TEXT"/>
            <column name="registrado_por" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_obra_avances_registrado_por" references="users(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260803-020-create-avance-evidencias" author="jorge">
        <createTable tableName="avance_evidencias">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="avance_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_avance_evidencias_avance_id" references="obra_avances(id)"/>
            </column>
            <column name="archivo_url" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="tipo" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="fase" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="descripcion" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
