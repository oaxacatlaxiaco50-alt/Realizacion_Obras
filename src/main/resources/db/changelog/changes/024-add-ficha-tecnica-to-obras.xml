<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="20261023-024-add-ficha-tecnica-to-obras" author="sistema">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="obras" columnName="fuente_financiamiento"/>
            </not>
        </preConditions>
        <addColumn tableName="obras">
            <column name="fuente_financiamiento" type="TEXT"/>
            <column name="beneficiarios" type="TEXT"/>
            <column name="impacto_social" type="TEXT"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
