        </insert>
        <insert tableName="permissions">
            <column name="name" value="RUTA_VIEW"/>
            <column name="description" value="Permiso para consultar rutas de obras"/>
        </insert>
        <insert tableName="permissions">
            <column name="name" value="RUTA_UPDATE"/>
            <column name="description" value="Permiso para actualizar rutas de obras"/>
        </insert>
        <insert tableName="permissions">
